# Required only for the live provider (`--provider anthropic`).
# The mock provider, the test suite and the eval harness all run without it.
ANTHROPIC_API_KEY=

# Model used for the agent loop.
OPS_COPILOT_MODEL=claude-sonnet-4-5

# Maximum tool-call iterations before the loop is force-stopped.
OPS_COPILOT_MAX_STEPS=6
