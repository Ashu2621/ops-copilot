# Model provider: mock (default, no key) | anthropic | openai
OPS_COPILOT_PROVIDER=mock

ANTHROPIC_API_KEY=
OPS_COPILOT_MODEL=claude-opus-5

OPENAI_API_KEY=
OPS_COPILOT_OPENAI_MODEL=gpt-4o

# Agent limits, per question
OPS_COPILOT_MAX_STEPS=6
OPS_COPILOT_MAX_COST_USD=0.25
OPS_COPILOT_MODEL_TIMEOUT_MS=60000
OPS_COPILOT_SQL_TIMEOUT_MS=2000

# HTTP (npm run serve)
PORT=8080
# /ask per token subject: burst, then sustained rate
OPS_COPILOT_ASK_BURST=10
OPS_COPILOT_ASK_PER_MINUTE=30
# "seed" answers time questions against the demo data's clock; "wall" for real data
OPS_COPILOT_CLOCK=seed

# OIDC. The server won't start without these.
OIDC_ISSUER=https://your-idp.example.com
OIDC_AUDIENCE=ops-copilot
# Optional, defaults to <issuer>/.well-known/jwks.json
OIDC_JWKS_URI=

# HMAC-SHA256 secret for inbound alert webhooks
WEBHOOK_SECRET=
