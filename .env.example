# ── Model provider ───────────────────────────────────────────────────────────
# mock (default, no key needed) | anthropic | openai
OPS_COPILOT_PROVIDER=mock

# Required only for --provider anthropic.
ANTHROPIC_API_KEY=
OPS_COPILOT_MODEL=claude-opus-5

# Required only for --provider openai. Demonstrates that the provider seam is
# a real abstraction rather than a mock-shaped hole.
OPENAI_API_KEY=
OPS_COPILOT_OPENAI_MODEL=gpt-4o

# Maximum tool-call iterations before the agent loop is force-stopped.
OPS_COPILOT_MAX_STEPS=6

# ── HTTP surface (npm run serve) ─────────────────────────────────────────────
PORT=8080

# OIDC. The server refuses to start without these rather than defaulting to an
# open endpoint. The token subject becomes the recorded approver on any refund,
# so this is what makes the human-in-the-loop guarantee auditable.
OIDC_ISSUER=https://your-idp.example.com
OIDC_AUDIENCE=ops-copilot
# Optional: defaults to <issuer>/.well-known/jwks.json
OIDC_JWKS_URI=

# Shared secret used to verify inbound alert webhook signatures (HMAC-SHA256).
WEBHOOK_SECRET=
