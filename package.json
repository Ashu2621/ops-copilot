{
  "name": "ops-copilot",
  "version": "1.0.0",
  "private": true,
  "description": "An agentic on-call assistant that answers operational questions by calling real tools, with engine-enforced guardrails and a scored evaluation harness.",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "seed": "tsx src/db/seed.ts",
    "ask": "tsx src/index.ts",
    "eval": "tsx evals/run.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "serve": "tsx src/serve.ts",
    "mcp": "tsx src/mcp/main.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "@langchain/core": "^1.2.9",
    "@langchain/langgraph": "^1.4.13",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "graphql": "^17.0.2",
    "jose": "^6.2.10",
    "openai": "^7.8.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
